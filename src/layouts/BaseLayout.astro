---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const { title = "Aldous | Portfolio" } = Astro.props;
---
<div class="site-loader" id="siteLoader" aria-label="Loading portfolio"><div class="loader-mark"><div class="loader-orb"></div><div class="loader-name">Aldous</div><div class="loader-line"></div></div></div><div class="page-transition" id="pageTransition" aria-hidden="true"></div>


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f5f7" />
    <meta name="description" content="Aldous Necesito — Computer Science student, web developer, UI/UX designer, editor, and tech enthusiast." />
    <link rel="icon" type="image/x-icon" href="/public/icons/favicon.png" />
    <title>{title}</title>
  </head>

  <body>
    <div class="aurora aurora-one"></div>
    <div class="aurora aurora-two"></div>
    <div class="grain"></div>
    <div class="scroll-progress"></div>

    <Navbar />

    <div class="page">
      <slot />
    </div>

    <div class="cursor-glow"></div>

    <div class="dock glass-panel" aria-label="Quick navigation">
      <a href="#home" data-scroll="home" aria-label="Home">⌂</a>
      <a href="#about" data-scroll="about" aria-label="About">✦</a>
      <a href="#projects" data-scroll="projects" aria-label="Projects">▣</a>
      <a href="#photos" data-scroll="photos" aria-label="Life">◌</a>
      <a href="#contact" data-scroll="contact" aria-label="Contact">✉</a>
    </div>

    <button class="command-hint glass-panel" id="commandHint" type="button">
      <kbd>⌘</kbd><kbd>K</kbd><span>Navigate</span>
    </button>

    <div class="command-palette" id="commandPalette" aria-hidden="true">
      <div class="palette-backdrop"></div>
      <div class="palette glass-panel" role="dialog" aria-modal="true" aria-label="Quick navigation">
        <div class="palette-head">
          <span>Quick Navigate</span>
          <button id="closePalette" type="button" aria-label="Close">Esc</button>
        </div>
        <input id="paletteInput" type="search" placeholder="Jump to a section…" autocomplete="off" />
        <div class="palette-items">
          <a href="#home" data-palette>Home <span>01</span></a>
          <a href="#about" data-palette>About <span>02</span></a>
          <a href="#projects" data-palette>Projects <span>03</span></a>
          <a href="#skills" data-palette>Skills <span>04</span></a>
          <a href="#certificates" data-palette>Certificates <span>05</span></a>
          <a href="#photos" data-palette>Life & Hobbies <span>06</span></a>
          <a href="#contact" data-palette>Contact <span>07</span></a>
        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const navLinks = document.querySelectorAll("[data-scroll]");
        const sections = document.querySelectorAll("section, main");
        const navbar = document.querySelector(".navbar");
        const glow = document.querySelector(".cursor-glow");
        const progress = document.querySelector(".scroll-progress");
        const palette = document.querySelector("#commandPalette");
        const paletteInput = document.querySelector("#paletteInput");
        const commandHint = document.querySelector("#commandHint");
        const closePalette = document.querySelector("#closePalette");

        function scrollToId(id) {
          const target = document.getElementById(id.replace("#", ""));
          if (!target) return;
          target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
        }

        navLinks.forEach((link) => {
          link.addEventListener("click", (event) => {
            const href = link.getAttribute("href");
            if (!href?.startsWith("#")) return;
            event.preventDefault();
            scrollToId(href);
            document.querySelector(".mobile-menu")?.classList.remove("open");
            document.querySelector(".nav-right")?.classList.remove("open");
          });
        });

        function updateUI() {
          navbar?.classList.toggle("scrolled", window.scrollY > 30);
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;

          let current = "home";
          sections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            if (rect.top <= window.innerHeight * 0.45 && rect.bottom >= window.innerHeight * 0.45) {
              current = section.id || current;
            }
          });

          navLinks.forEach((link) => {
            link.classList.toggle("active", link.getAttribute("data-scroll") === current);
          });
        }

        window.addEventListener("scroll", updateUI, { passive: true });
        updateUI();

        const revealEls = document.querySelectorAll(".reveal");
        if (reduceMotion) revealEls.forEach((el) => el.classList.add("active"));
        else {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08 });
          revealEls.forEach((el) => observer.observe(el));
        }

        if (!reduceMotion && glow) {
          let mouseX = innerWidth / 2, mouseY = innerHeight / 2;
          let currentX = mouseX, currentY = mouseY;
          document.addEventListener("mousemove", (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
          });
          function animateGlow() {
            currentX += (mouseX - currentX) * 0.08;
            currentY += (mouseY - currentY) * 0.08;
            glow.style.transform = `translate(${currentX}px, ${currentY}px)`;
            requestAnimationFrame(animateGlow);
          }
          animateGlow();
        }

        document.querySelectorAll(".project-card, .life-card, .skill-card").forEach((card) => {
          card.addEventListener("pointermove", (e) => {
            if (reduceMotion || window.innerWidth < 900) return;
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            card.style.setProperty("--shine-x", `${x * 100}%`);
            card.style.setProperty("--shine-y", `${y * 100}%`);
            card.style.setProperty("--rx", `${(0.5 - y) * 5}deg`);
            card.style.setProperty("--ry", `${(x - 0.5) * 5}deg`);
            card.style.setProperty("--mx", `${x * 100}%`);
            card.style.setProperty("--my", `${y * 100}%`);
          });
          card.addEventListener("pointerleave", () => {
            card.style.removeProperty("--rx");
            card.style.removeProperty("--ry");
            card.style.removeProperty("--shine-x");
            card.style.removeProperty("--shine-y");
          });
        });



        const heroWindow = document.querySelector(".hero-window");
        if (!reduceMotion && heroWindow) {
          document.addEventListener("mousemove", (e) => {
            const x = (e.clientX / window.innerWidth - 0.5);
            const y = (e.clientY / window.innerHeight - 0.5);
            heroWindow.style.setProperty("--hero-x", `${x * 6}px`);
            heroWindow.style.setProperty("--hero-y", `${y * 4}px`);
          }, { passive: true });
        }
        document.querySelectorAll(".magnetic").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            if (reduceMotion) return;
            const rect = el.getBoundingClientRect();
            el.style.transform = `translate(${(e.clientX - rect.left - rect.width / 2) * 0.08}px, ${(e.clientY - rect.top - rect.height / 2) * 0.08}px)`;
          });
          el.addEventListener("pointerleave", () => el.style.transform = "");
        });

        function openPalette() {
          palette.classList.add("open");
          palette.setAttribute("aria-hidden", "false");
          setTimeout(() => paletteInput?.focus(), 50);
        }
        function hidePalette() {
          palette.classList.remove("open");
          palette.setAttribute("aria-hidden", "true");
        }

        commandHint?.addEventListener("click", openPalette);
        closePalette?.addEventListener("click", hidePalette);
        palette?.querySelector(".palette-backdrop")?.addEventListener("click", hidePalette);

        document.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            openPalette();
          }
          if (e.key === "Escape") hidePalette();
        });

        document.querySelectorAll("[data-palette]").forEach((item) => {
          item.addEventListener("click", () => {
            hidePalette();
            scrollToId(item.getAttribute("href"));
          });
        });

        paletteInput?.addEventListener("input", () => {
          const query = paletteInput.value.toLowerCase();
          document.querySelectorAll("[data-palette]").forEach((item) => {
            item.hidden = !item.textContent.toLowerCase().includes(query);
          });
        });

        document.querySelector(".mobile-menu")?.addEventListener("click", () => {
          document.querySelector(".mobile-menu").classList.toggle("open");
          document.querySelector(".nav-right").classList.toggle("open");
        });

        const form = document.querySelector(".contact-form");
        form?.addEventListener("submit", (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const name = data.get("name") || "there";
          const email = data.get("email") || "";
          const message = data.get("message") || "";
          const subject = encodeURIComponent(`Portfolio inquiry from ${name}`);
          const body = encodeURIComponent(`Hi Aldous,\n\n${message}\n\nReply to: ${email}`);
          window.location.href = `mailto:jeanaldousnecesito@gmail.com?subject=${subject}&body=${body}`;
        });
      });
    </script>
  </body>
</html>

<script is:inline>
(() => { const loader=document.getElementById('siteLoader'); if(!loader)return; const hide=()=>loader.classList.add('is-hidden'); if(document.readyState==='complete') setTimeout(hide,350); else window.addEventListener('load',()=>setTimeout(hide,350),{once:true}); setTimeout(hide,1500); })();
(() => { const overlay=document.getElementById('pageTransition'); if(!overlay)return; document.querySelectorAll('.nav-link[href^="#"]').forEach(link=>link.addEventListener('click',()=>{const r=link.getBoundingClientRect(); overlay.style.setProperty('--transition-x',`${r.left+r.width/2}px`); overlay.style.setProperty('--transition-y',`${r.top+r.height/2}px`); link.classList.remove('nav-pulse'); void link.offsetWidth; link.classList.add('nav-pulse'); overlay.classList.add('active'); setTimeout(()=>overlay.classList.remove('active'),500);})); })();


// Clean pointer-following 3D card tilt.
(() => {
  if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  document.querySelectorAll(
    '.project-card, .skill-card, .life-card, .tech-card, .profile-card'
  ).forEach(card => {
    let raf = 0;
    let tx = 0, ty = 0, cx = 0, cy = 0;

    const draw = () => {
      cx += (tx - cx) * .16;
      cy += (ty - cy) * .16;
      card.style.setProperty('--tilt-x', `${cx.toFixed(2)}deg`);
      card.style.setProperty('--tilt-y', `${cy.toFixed(2)}deg`);
      if (Math.abs(tx-cx) > .01 || Math.abs(ty-cy) > .01) {
        raf = requestAnimationFrame(draw);
      } else raf = 0;
    };

    card.addEventListener('pointermove', e => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;

      // Maximum ~7 degrees: noticeable, but still Apple-like.
      tx = (.5 - y) * 7;
      ty = (x - .5) * 7;

      card.style.setProperty('--mx', `${x * 100}%`);
      card.style.setProperty('--my', `${y * 100}%`);

      if (!raf) raf = requestAnimationFrame(draw);
    });

    card.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      card.style.setProperty('--mx', '50%');
      card.style.setProperty('--my', '50%');
      if (!raf) raf = requestAnimationFrame(draw);
    });
  });
})();

// Lightweight scroll parallax.
// Only selected elements move; the document itself remains normal and crisp.
(() => {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const items = [
    ...document.querySelectorAll('.hero-window, .profile-card, .section-heading, [data-parallax]')
  ];

  if (!items.length) return;

  let ticking = false;

  const update = () => {
    const vh = window.innerHeight;

    items.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      if (r.bottom < -120 || r.top > vh + 120) return;

      const center = r.top + r.height / 2;
      const distance = (center - vh / 2) / vh;

      // Different layers move at different speeds.
      const strength = el.hasAttribute('data-parallax')
        ? parseFloat(el.dataset.parallax || '0.10')
        : (i % 3 === 0 ? 0.045 : 0.025);

      const y = distance * strength * -70;
      el.style.transform = `translate3d(0, ${y.toFixed(2)}px, 0)`;
    });

    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };

  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll, {passive:true});
  update();
})();

// Navbar navigation: no overlay and no instant hash jump.
// We smoothly scroll to the target with the navbar offset, then update the hash.
(() => {
  document.querySelectorAll('.nav-link[href^="#"]').forEach(link => {
    link.addEventListener('click', e => {
      const href = link.getAttribute('href');
      const target = href ? document.querySelector(href) : null;
      if (!target) return;

      e.preventDefault();

      const header = document.querySelector('.navbar, nav');
      const offset = header ? header.getBoundingClientRect().height + 18 : 92;
      const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset);

      // Tiny click feedback, without covering or blurring the page.
      link.classList.remove('nav-pulse');
      void link.offsetWidth;
      link.classList.add('nav-pulse');

      window.scrollTo({
        top,
        behavior: 'smooth'
      });

      // Update the URL after the smooth scroll starts so the browser
      // doesn't perform its own second jump.
      history.replaceState(null, '', href);
    });
  });
})();

</script>
