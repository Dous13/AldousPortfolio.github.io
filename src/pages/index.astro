
---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const projects = [
  {
    number: "01",
    category: "WEB DEVELOPMENT",
    year: "2020",
    title: "EasyPM Pest Management Philadelphia",
    description:
      "A simple, responsive website for a local pest management business, built to showcase its services and contact information.",
    image: "easypm.png",
    alt: "EasyPM Pest Management Philadelphia website preview",
    tags: ["Astro", "CSS", "JavaScript", "Sanity"],
    links: [
      { label: "GitHub", href: "https://github.com/Dous13/Zidousblog.github.io" },
      { label: "Live Demo", href: "https://dous13.github.io/Zidousblog.github.io/index.html" },
    ],
  },
  {
    number: "02",
    category: "SMALL BUSINESS",
    year: "—",
    title: "Laundry Services Site",
    description:
      "A website for a local laundry business, built to present its services through a clear and accessible interface.",
    image: "laundryscience.png",
    alt: "Laundry services website preview",
    tags: ["HTML", "CSS", "JavaScript", "Bootstrap"],
    links: [
      { label: "Live Demo", href: "https://easypm.com/" },
    ],
  },
  {
    number: "03",
    category: "MOBILE APPLICATION",
    year: "—",
    title: "School Community App",
    description:
      "A React Native community app featuring messaging, ordering, renting, and a campus-focused home page.",
    image: "sucommunityapp.jpg",
    alt: "School community mobile app preview",
    tags: ["React Native", "Firebase", "Node.js"],
    links: [
      { label: "GitHub", href: "https://github.com/Dous13/sucommunityapp" },
    ],
  },
  {
    number: "04",
    category: "SOCIAL IMPACT",
    year: "—",
    title: "Animal Sanctuary Site",
    description:
      "A sanctuary website centered on animal adoption, useful information, and a welcoming visual experience.",
    image: "adoption.png",
    alt: "Animal sanctuary website preview",
    tags: ["HTML", "SCSS", "JavaScript", "Firebase"],
    links: [
      { label: "GitHub", href: "https://github.com/Dous13/AnimalSanctuary.github.io" },
      { label: "Live Demo", href: "https://dous13.github.io/AnimalSanctuary.github.io/index.html" },
    ],
  },
  {
    number: "05",
    category: "SCHOOL THESIS",
    year: "—",
    title: "Lumikids: Learning Made Fun",
    description:
      "A thesis project that combines a web application and a mobile app to create an interactive learning experience for children.",
    image: "lumikids.jpg",
    alt: "Lumikids website preview",
    tags: ["React Native", "JavaScript", "Firebase"],
    links: [
      { label: "GitHub", href: "https://github.com/Dous13/Lumikids.github.io" },
      { label: "Live Demo", href: "https://dous13.github.io/Lumikids.github.io/" },
    ],
  },
];

const technologies = [
  { name: "Astro", image: "Astro.svg" },
  { name: "React", image: "React.svg" },
  { name: "Firebase", image: "Firebase.svg" },
  { name: "Python", image: "Python.svg" },
  { name: "MySQL", image: "MySQL.svg" },
  { name: "Node.js", image: "Node.js.svg" },
  { name: "HTML", image: "HTML5.svg" },
  { name: "CSS", image: "CSS3.svg" },
  { name: "JavaScript", image: "JavaScript.svg" },
  { name: "Git", image: "Git.svg" },
  { name: "GitHub", image: "GitHub.svg" },
  { name: "C#", image: "Csharp.svg" },
];

const certificates = ["1.jpg", "2.jpg", "3.jpg", "4.jpg", "5.jpg", "6.jpg"];

const lifePhotos = [
  {
    image: "sky.jpeg",
    alt: "Dumaguete skyline during sunset",
    category: "PLACE",
    title: "Golden Hour",
    description: "Dumaguete skyline during sunset.",
    className: "large",
  },
  {
    image: "setup.jpeg",
    alt: "Aldous's computer setup",
    category: "SETUP",
    title: "The Machine",
    description: "The setup that does a little bit of everything.",
    className: "",
  },
  {
    image: "keeb.jpeg",
    alt: "Mechanical keyboard",
    category: "HOBBY",
    title: "Keeb",
    description: "A calm hobby between projects.",
    className: "tall",
  },
  {
    image: "reflections.jpeg",
    alt: "Reflections on water",
    category: "PHOTO",
    title: "Reflections",
    description: "Water and light symmetry.",
    className: "",
  },
  {
    image: "dog.jpeg",
    alt: "Dog portrait",
    category: "LIFE",
    title: "Dog & Smile",
    description: "The important stuff.",
    className: "",
  },
  {
    image: "time.jpeg",
    alt: "Time-themed photograph",
    category: "THOUGHT",
    title: "Time",
    description: "Time is gold.",
    className: "",
  },
];
---

<BaseLayout title="Aldous | Digital Portfolio">

  <main>
    <!-- HERO -->
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="hero-window reveal">
        <div class="window-bar">
          <div class="window-controls" aria-hidden="true">
            <span class="traffic red"></span>
            <span class="traffic yellow"></span>
            <span class="traffic green"></span>
          </div>
          <span class="window-title">Aldous — Portfolio</span>
          <span class="window-status"><span class="status-dot"></span> Available</span>
        </div>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="status-dot"></span>
              Computer Science Student · Dumaguete
            </div>

            <h1 id="hero-title">
              I build things<br />
              <span>with a little soul.</span>
            </h1>

            <p class="hero-lede">
              I'm Aldous — a CS student who likes turning ideas into polished
              websites, useful apps, thoughtful interfaces, and visual stories.
            </p>

            <div class="buttons">
              <a class="primary-btn magnetic" href="#projects">
                Explore my work <span aria-hidden="true">↗</span>
              </a>
              <a class="glass-btn magnetic" href="#contact">Say hello</a>
            </div>

            <div class="hero-meta" aria-label="Areas of interest">
              <div><strong>01</strong><span>Developer</span></div>
              <div><strong>02</strong><span>Designer</span></div>
              <div><strong>03</strong><span>Editor</span></div>
            </div>
          </div>

          <div class="hero-profile">
            <div class="profile-orbit" aria-hidden="true"></div>

            <div class="profile-card glass-panel">
              <div class="profile-top">
                <span>hello_world.jpg</span>
                <span>2026</span>
              </div>

              <img
                src={`${base}images/archie.jpeg`}
                alt="Portrait of Aldous Necesito"
                width="600"
                height="700"
                fetchpriority="high"
              />

              <div class="profile-caption">
                <div>
                  <strong>Aldous Necesito</strong>
                  <span>BS Computer Science</span>
                </div>
                <span class="mini-chip">Open to opportunities</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a class="scroll-cue" href="#about">
        <span aria-hidden="true"></span>
        Scroll to explore
      </a>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section about reveal" aria-labelledby="about-title">
      <div class="section-intro">
        <span class="section-number">01 / INTRODUCTION</span>
        <h2 id="about-title">A little about <em>me.</em></h2>
        <p>Get to know the person behind the projects.</p>
      </div>

      <div class="about-grid">
        <article class="about-note glass-panel">
          <div class="note-pin" aria-hidden="true"></div>
          <span class="note-label">A little note</span>

          <p>
            I'm the kind of person who can spend an afternoon fixing a tiny UI
            detail, then lose an hour making a desktop setup look just right.
            I like technology, but I care just as much about how it feels to use.
          </p>

          <p>
            My work sits somewhere between software development, design, and
            creative editing. I enjoy learning by making — especially when the
            result solves a real problem or makes someone's day a little easier.
          </p>

          <div class="about-tags">
            <span>Web Development</span>
            <span>UI/UX</span>
            <span>Creative Editing</span>
            <span>Problem Solving</span>
            <span>Technology</span>
          </div>
        </article>

        <div class="about-side">
          <div class="quote-card glass-panel">
            <span class="quote-mark" aria-hidden="true">“</span>
            <p>Build it well.<br />Make it feel good.<br />Keep it human.</p>
          </div>

          <div class="mini-stats">
            <div class="stat glass-panel"><strong>CS</strong><span>Student</span></div>
            <div class="stat glass-panel"><strong>Web</strong><span>Focus</span></div>
            <div class="stat glass-panel"><strong>UI</strong><span>Mindset</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TOOLBOX -->
    <section id="toolbox" class="section tech-stack reveal" aria-labelledby="toolbox-title">
      <div class="section-intro centered">
        <span class="section-number">02 / TOOLBOX</span>
        <h2 id="toolbox-title">Things I like <em>building with.</em></h2>
        <p>My current stack, from code to creative work.</p>
      </div>

      <div class="tech-grid glass-panel">
        {technologies.map((tech) => (
          <div class="tech-item">
            <img
              src={`${base}images/${tech.image}`}
              alt=""
              width="40"
              height="40"
              loading="lazy"
            />
            <span>{tech.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section projects reveal" aria-labelledby="projects-title">
      <div class="section-intro">
        <span class="section-number">03 / SELECTED WORK</span>
        <h2 id="projects-title">Things I've <em>made.</em></h2>
        <p>A mix of school projects, experiments, and real-world builds.</p>
      </div>

      <div class="projects-grid">
        {projects.map((project, index) => (
          <article class:list={["project-card", "glass-panel", { featured: index === 0 }]}>
            <div class="project-window-bar">
              <div class="window-controls" aria-hidden="true">
                <span class="traffic red"></span>
                <span class="traffic yellow"></span>
                <span class="traffic green"></span>
              </div>
              <span>{project.number} — {project.category.toLowerCase()}</span>
              <span class="project-year">{project.year}</span>
            </div>

            <img
              src={`${base}images/${project.image}`}
              alt={project.alt}
              width="800"
              height="500"
              loading="lazy"
            />

            <div class="project-content">
              <div class="project-kicker">{project.category}</div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>

              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <div class="links">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="section skills reveal" aria-labelledby="skills-title">
      <div class="section-intro centered">
        <span class="section-number">04 / WHAT I DO</span>
        <h2 id="skills-title">More than <em>just code.</em></h2>
        <p>A few of the ways I enjoy creating and solving problems.</p>
      </div>

      <div class="skills-grid">
        <article class="skill-card glass-panel">
          <span class="skill-icon" aria-hidden="true">⌘</span>
          <h3>Web Development</h3>
          <p>Responsive websites, frontend interfaces, APIs, databases, and practical web experiences.</p>
          <div class="skill-list">
            <span>HTML</span><span>CSS</span><span>JavaScript</span><span>PHP</span><span>MySQL</span>
          </div>
        </article>

        <article class="skill-card glass-panel">
          <span class="skill-icon" aria-hidden="true">✦</span>
          <h3>UI / UX Design</h3>
          <p>Layouts, visual systems, prototypes, and interfaces designed around clarity and ease of use.</p>
          <div class="skill-list">
            <span>Figma</span><span>UI/UX</span><span>Canva</span><span>Prototyping</span>
          </div>
        </article>

        <article class="skill-card glass-panel">
          <span class="skill-icon" aria-hidden="true">◉</span>
          <h3>Photo & Video</h3>
          <p>Editing and visual storytelling when a project needs something beyond the browser.</p>
          <div class="skill-list">
            <span>Photoshop</span><span>Premiere Pro</span><span>Final Cut</span><span>DaVinci</span>
          </div>
        </article>

        <article class="skill-card glass-panel">
          <span class="skill-icon" aria-hidden="true">⚙</span>
          <h3>Tech & Hardware</h3>
          <p>PC building, diagnostics, troubleshooting, and the occasional obsession over a clean setup.</p>
          <div class="skill-list">
            <span>PC Building</span><span>Diagnostics</span><span>Troubleshooting</span>
          </div>
        </article>
      </div>
    </section>

    <!-- CERTIFICATES -->
    <section id="certificates" class="section gallery-section reveal" aria-labelledby="certificates-title">
      <div class="section-intro">
        <span class="section-number">05 / MILESTONES</span>
        <h2 id="certificates-title">Things I've <em>learned.</em></h2>
        <p>A few certificates and milestones from the journey so far.</p>
      </div>

      <div class="certificate-wall">
        {certificates.map((certificate, index) => (
          <figure class="certificate-card">
            <img
              src={`${base}images/certificates/${certificate}`}
              alt={`Certificate ${index + 1}`}
              width="800"
              height="600"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </section>

    <!-- LIFE -->
    <section id="photos" class="section life reveal" aria-labelledby="life-title">
      <div class="section-intro centered">
        <span class="section-number">06 / OFF THE SCREEN</span>
        <h2 id="life-title">A little bit of <em>real life.</em></h2>
        <p>The hobbies, places, and little things that make the work feel like mine.</p>
      </div>

      <div class="life-grid">
        {lifePhotos.map((photo) => (
          <article class:list={["life-card", "glass-panel", photo.className]}>
            <img
              src={`${base}images/${photo.image}`}
              alt={photo.alt}
              width="700"
              height="500"
              loading="lazy"
            />
            <div class="photo-info">
              <span>{photo.category}</span>
              <h3>{photo.title}</h3>
              <p>{photo.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact reveal" aria-labelledby="contact-title">
      <div class="contact-window glass-panel">
        <div class="window-bar">
          <div class="window-controls" aria-hidden="true">
            <span class="traffic red"></span>
            <span class="traffic yellow"></span>
            <span class="traffic green"></span>
          </div>
          <span class="window-title">new_message — Aldous</span>
          <span class="window-status"><span class="status-dot"></span> Online</span>
        </div>

        <div class="contact-container">
          <div class="contact-info">
            <span class="section-number">07 / CONTACT</span>
            <h2 id="contact-title">Let's make something<br /><em>worth opening.</em></h2>
            <p>
              Have a project, internship opportunity, freelance idea, or just want
              to talk about tech? My inbox is open.
            </p>

            <div class="contact-links">
              <a href="mailto:jeanaldousnecesito@gmail.com">
                ✉ Email me <span aria-hidden="true">↗</span>
              </a>
              <a href="https://github.com/Dous13" target="_blank" rel="noopener noreferrer">
                ⌘ GitHub <span aria-hidden="true">↗</span>
              </a>
              <a href="https://www.linkedin.com/in/jean-aldous-necesito-8b56a7285/" target="_blank" rel="noopener noreferrer">
                in LinkedIn <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <form class="contact-form" id="contact-form">
            <label>
              Name
              <input name="name" type="text" placeholder="Your name" autocomplete="name" required />
            </label>

            <label>
              Email
              <input name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
            </label>

            <label>
              Message
              <textarea name="message" placeholder="Tell me what you're building…" rows="5" required></textarea>
            </label>

            <button class="primary-btn magnetic" type="submit">
              Send message <span aria-hidden="true">↗</span>
            </button>

            <small>This opens your email app. Your message is not stored on this website.</small>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <a class="footer-brand" href="#home" aria-label="Back to home">
        <span class="logo-mark">A</span>
        <strong>Aldous.</strong>
      </a>

      <p>Built with curiosity, too many browser tabs, and a lot of care.</p>
      <span>© {new Date().getFullYear()} Aldous Necesito</span>
    </div>
  </footer>

  <script>
    const contactForm = document.querySelector<HTMLFormElement>("#contact-form");

    contactForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!contactForm.reportValidity()) return;

      const formData = new FormData(contactForm);
      const name = String(formData.get("name") || "");
      const email = String(formData.get("email") || "");
      const message = String(formData.get("message") || "");

      const subject = encodeURIComponent(`Portfolio inquiry from ${name}`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\n\n${message}`
      );

      window.location.href =
        `mailto:jeanaldousnecesito@gmail.com?subject=${subject}&body=${body}`;
    });
  </script>

</BaseLayout>
